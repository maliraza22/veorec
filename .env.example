# ─────────────────────────────────────────────────────────────────────────────
# VeoRec environment template  —  copy to .env and adjust for your machine.
#
#   cp .env.example .env
#
# NEVER commit .env (it is gitignored). Never put staging/production secrets in
# a local .env (docs/17 §9: production credentials are separate from dev).
# Values below are LOCAL DEVELOPMENT defaults only — none of them are secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this process is running as: local | test | staging | production
# Controls safety guards: destructive DB commands (db:reset) are refused unless
# this is local or test, and are ALWAYS refused for production.
APP_ENV=local

# ── PostgreSQL — source of application truth (docs/02 §11) ───────────────────
# Host port 5433 (not 5432) so the dev stack never collides with a Postgres
# already installed on your machine. Matches docker-compose.yml.
DATABASE_URL=postgres://veorec:veorec_local_dev@127.0.0.1:5433/veorec
# Separate database used by `cd db && npm test` — it is TRUNCATED/RESET by tests.
DATABASE_URL_TEST=postgres://veorec:veorec_local_dev@127.0.0.1:5433/veorec_test
# disable | require  (managed Postgres in staging/production normally needs require)
DATABASE_SSL=disable
# Connection pool sizing / safety timeouts (optional; sane defaults in code).
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# Overrides consumed by docker-compose.yml (optional — defaults shown).
# POSTGRES_USER=veorec
# POSTGRES_PASSWORD=veorec_local_dev
# POSTGRES_DB=veorec
# POSTGRES_PORT=5433

# ── Redis — BullMQ queues + rate limits (never authoritative) ────────────────
REDIS_URL=redis://127.0.0.1:6380
# REDIS_PORT=6380

# ── Object storage ───────────────────────────────────────────────────────────
# LOCAL: MinIO (S3-compatible substitute). PRODUCTION: Cloudflare R2.
# Consumed by the StorageProvider abstraction arriving in T-201 — not used yet.
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://127.0.0.1:9100
STORAGE_REGION=auto
STORAGE_BUCKET=veorec-media-local
STORAGE_ACCESS_KEY_ID=veorec_dev
STORAGE_SECRET_ACCESS_KEY=veorec_local_dev_secret
STORAGE_FORCE_PATH_STYLE=true
# MINIO_ROOT_USER=veorec_dev
# MINIO_ROOT_PASSWORD=veorec_local_dev_secret
# MINIO_PORT=9100
# MINIO_CONSOLE_PORT=9101
#
# PRODUCTION (Cloudflare R2) — set these ONLY in the production secret store:
#   STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_BUCKET=veorec-media
#   STORAGE_ACCESS_KEY_ID=<r2-access-key-id>
#   STORAGE_SECRET_ACCESS_KEY=<r2-secret-access-key>

# ── Mail — MailHog locally (captures, never delivers) ────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# MAILHOG_UI_PORT=8025
# Production uses the Brevo API key on the legacy server (BREVO_API_KEY).

# ── PostgreSQL dual-write mirror (T-105) ────────────────────────────────────
# OFF unless this is exactly "true". When off, the legacy server loads no
# database code at all. PostgreSQL is a MIRROR — the legacy JSON/Cloudinary
# path stays authoritative, and a mirror failure never changes a response.
# Disable instantly by setting false (or removing the line) and restarting.
# PG_DUAL_WRITE=false
# PG_DUAL_WRITE_TIMEOUT_MS=5000
# PG_DUAL_WRITE_MAX_QUEUED=500
# PG_DUAL_WRITE_CIRCUIT_THRESHOLD=3
# PG_DUAL_WRITE_CIRCUIT_COOLDOWN_MS=30000

# ── Observability (T-002/T-003) ──────────────────────────────────────────────
# LOG_LEVEL=debug
# LOG_PRETTY=true
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=

# ── Legacy server (server/) — unchanged by the migration so far ──────────────
# See docs/01 §8 for the full legacy variable list. Examples:
# JWT_SECRET=change-me-locally
# DATA_DIR=./server
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# GROQ_API_KEY=
# PADDLE_ENVIRONMENT=sandbox
