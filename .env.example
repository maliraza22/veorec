# ─────────────────────────────────────────────────────────────────────────────
# VeoRec environment template  —  copy to .env and adjust for your machine.
#
#   cp .env.example .env
#
# NEVER commit .env (it is gitignored). Never put staging/production secrets in
# a local .env (docs/17 §9: production credentials are separate from dev).
# Values below are LOCAL DEVELOPMENT defaults only — none of them are secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this process is running as: local | test | staging | production
# Controls safety guards: destructive DB commands (db:reset) are refused unless
# this is local or test, and are ALWAYS refused for production.
APP_ENV=local

# ── PostgreSQL — source of application truth (docs/02 §11) ───────────────────
# Host port 5433 (not 5432) so the dev stack never collides with a Postgres
# already installed on your machine. Matches docker-compose.yml.
DATABASE_URL=postgres://veorec:veorec_local_dev@127.0.0.1:5433/veorec
# Separate database used by `cd db && npm test` — it is TRUNCATED/RESET by tests.
DATABASE_URL_TEST=postgres://veorec:veorec_local_dev@127.0.0.1:5433/veorec_test
# disable | require  (managed Postgres in staging/production normally needs require)
DATABASE_SSL=disable
# Connection pool sizing / safety timeouts (optional; sane defaults in code).
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# Overrides consumed by docker-compose.yml (optional — defaults shown).
# POSTGRES_USER=veorec
# POSTGRES_PASSWORD=veorec_local_dev
# POSTGRES_DB=veorec
# POSTGRES_PORT=5433

# ── Redis — BullMQ queues + rate limits (never authoritative) ────────────────
REDIS_URL=redis://127.0.0.1:6380
# REDIS_PORT=6380

# ── Object storage ───────────────────────────────────────────────────────────
# LOCAL: MinIO (S3-compatible substitute). PRODUCTION: Cloudflare R2.
# Consumed by @veorec/storage (T-201). R2 and MinIO run the SAME provider code —
# only these values differ, so what you exercise locally is what ships.
STORAGE_PROVIDER=minio                 # minio | r2 | s3 — configuration flavour only
STORAGE_ENDPOINT=http://127.0.0.1:9100
STORAGE_REGION=auto
STORAGE_BUCKET=veorec-media-local
STORAGE_ACCESS_KEY_ID=veorec_dev
STORAGE_SECRET_ACCESS_KEY=veorec_local_dev_secret
STORAGE_FORCE_PATH_STYLE=true          # required by R2; also simplest for MinIO
# MINIO_ROOT_USER=veorec_dev
# MINIO_ROOT_PASSWORD=veorec_local_dev_secret
# MINIO_PORT=9100
# MINIO_CONSOLE_PORT=9101
#
# Optional tuning (defaults shown). A signed URL is a bearer credential for one
# object, so the TTL ceiling is a security control, not a preference:
# STORAGE_MAX_SIGNED_URL_TTL=604800    # hard cap; 7d is the SigV4 maximum
# STORAGE_GET_TTL=600                  # default signed GET — 10 min (docs/12 §6)
# STORAGE_PUT_TTL=3600                 # default signed PUT — 1 h
# STORAGE_REQUEST_TIMEOUT_MS=30000
# STORAGE_MAX_ATTEMPTS=3
#
# ── Bucket policy for browser-direct uploads (T-202) ────────────────────────
# Origins allowed to PUT parts and GET media DIRECTLY from the bucket. This is
# the BUCKET's CORS policy, separate from the API's own CORS allowlist
# (docs/17 4). Comma-separated, explicit origins only: a wildcard is refused,
# because the media bucket is private and a '*' origin would let any page drive
# a presigned URL that leaked into it.
# Local/test default to the dev server; staging/production have NO default and
# must list their real origins - we do not invent production domains.
STORAGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# STORAGE_CORS_MAX_AGE=3600            # preflight cache seconds
#
# PRODUCTION example (set in the secret store, not here):
#   STORAGE_CORS_ORIGINS=https://veorec.com,https://www.veorec.com,chrome-extension://<prod-extension-id>
#
# Apply/verify the bucket policy (private bucket, 48h incomplete-multipart
# abort, CORS) with:   cd storage && npm run storage:provision            # check
#                      cd storage && npm run storage:provision -- --apply # write
#
# PRODUCTION (Cloudflare R2) — set these ONLY in the production secret store,
# never in this file and never in the repository:
#   STORAGE_PROVIDER=r2
#   STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # https required
#   STORAGE_BUCKET=veorec-media
#   STORAGE_ACCESS_KEY_ID=<r2-access-key-id>
#   STORAGE_SECRET_ACCESS_KEY=<r2-secret-access-key>
# APP_ENV=staging|production has NO defaults: a missing value fails fast rather
# than silently falling back to the local MinIO.

# ── Mail — MailHog locally (captures, never delivers) ────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# MAILHOG_UI_PORT=8025
# Production uses the Brevo API key on the legacy server (BREVO_API_KEY).

# ── PostgreSQL dual-write mirror (T-105) ────────────────────────────────────
# OFF unless this is exactly "true". When off, the legacy server loads no
# database code at all. PostgreSQL is a MIRROR — the legacy JSON/Cloudinary
# path stays authoritative, and a mirror failure never changes a response.
# Disable instantly by setting false (or removing the line) and restarting.
# PG_DUAL_WRITE=false
# PG_DUAL_WRITE_TIMEOUT_MS=5000
# PG_DUAL_WRITE_MAX_QUEUED=500
# PG_DUAL_WRITE_CIRCUIT_THRESHOLD=3
# PG_DUAL_WRITE_CIRCUIT_COOLDOWN_MS=30000

# ── R2 upload mirror (T-203) ────────────────────────────────────────────────
# OFF unless this is exactly "true". When off, the storage package is never
# loaded and the upload handler behaves exactly as before — so disabling it and
# restarting is an instant rollback.
# After a legacy upload SUCCEEDS, the same bytes are copied to R2 at
# sources/rec_<id>/source.<ext> and a video_assets row is recorded. Cloudinary
# (or the local disk store) stays AUTHORITATIVE: the mirror runs after the
# response and can never fail, delay, or alter an upload.
# Requires the STORAGE_* settings above. The asset ROW additionally requires
# PG_DUAL_WRITE=true, because video_assets has a foreign key to the recordings
# row that the dual-write mirror creates; without it the bytes are still
# mirrored and reconciliation picks up the missing row.
# R2_MIRROR_UPLOADS=false
# R2_MIRROR_CONCURRENCY=2          # parallel mirrors; the rest queue
# R2_MIRROR_MAX_QUEUED=100         # beyond this, shed to the journal
# R2_MIRROR_TIMEOUT_MS=300000

# ── /api/v1 upload session API (T-301) ──────────────────────────────────────
# OFF unless exactly "true". When off, the api/db/storage packages are never
# loaded and the legacy server is byte-identical to before.
# Adds POST/GET/DELETE /api/v1/uploads + parts presign/record/complete. The
# LEGACY POST /api/upload is unchanged and remains the path current clients use.
# Requires the STORAGE_* settings and a reachable PostgreSQL.
# V1_UPLOAD_API=false
# UPLOAD_MAX_BYTES=536870912       # per-recording byte ceiling until T-306 ships the quota ledger

# ── Observability (T-002/T-003) ──────────────────────────────────────────────
# LOG_LEVEL=debug
# LOG_PRETTY=true
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=

# ── Legacy server (server/) — unchanged by the migration so far ──────────────
# See docs/01 §8 for the full legacy variable list. Examples:
# JWT_SECRET=change-me-locally
# DATA_DIR=./server
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# GROQ_API_KEY=
# PADDLE_ENVIRONMENT=sandbox
